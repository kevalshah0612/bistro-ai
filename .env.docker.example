# Copy to .env.docker in the repo root, then: npm run docker:up
# Docker loads THIS file (not .env). DATABASE_URL here is ignored — compose uses container Postgres.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_CACHE_ENABLED=true
AI_CACHE_TTL_MS=3600000
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
CORS_ORIGIN=*
